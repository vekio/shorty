package components

templ APIKeyPanel(data APIKeyPanelData) {
	<div id="api-key-management">
		if data.Error != "" {
			<p class="mb-6 border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800">{ data.Error }</p>
		}
		if data.NewToken != "" {
			<section class="mb-6 border border-amber-300 bg-amber-50 p-4">
				<h2 class="font-semibold text-amber-950">Copy this token now</h2>
				<p class="mt-1 text-sm text-amber-800">It will not be displayed again.</p>
				<code id="new-token" class="mt-3 block break-all border border-amber-200 bg-white p-3 text-sm">{ data.NewToken }</code>
				<button class="mt-3 border border-zinc-900 bg-zinc-900 px-3 py-2 text-sm font-medium text-white hover:bg-zinc-700" type="button" onclick="navigator.clipboard.writeText(document.getElementById('new-token').textContent)">Copy token</button>
			</section>
			<script>history.replaceState(null, "", "/_/");</script>
		}
		<section class="border border-zinc-300 bg-white p-5">
			<h2 class="text-lg font-semibold">Create token</h2>
			<form
				class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-end"
				hx-post="/_/api-keys"
				hx-target="#api-key-management"
				hx-swap="outerHTML"
			>
				<label class="flex-1 text-sm font-medium text-zinc-700">
					Name
					<input class="mt-1 block w-full border border-zinc-400 bg-white px-3 py-2 outline-none focus:border-zinc-900" name="name" placeholder="CI deployment" required/>
				</label>
				<button class="border border-zinc-900 bg-zinc-900 px-4 py-2 text-sm font-medium text-white hover:bg-zinc-700" type="submit">Create token</button>
			</form>
		</section>
		<section class="mt-6 border border-zinc-300 bg-white">
			<div class="border-b border-zinc-300 px-5 py-4">
				<h2 class="text-lg font-semibold">Tokens</h2>
			</div>
			if len(data.APIKeys) > 0 {
				<div class="overflow-x-auto">
					<table class="w-full border-collapse text-left text-sm">
						<thead class="bg-zinc-50 text-xs uppercase tracking-wide text-zinc-500">
							<tr>
								<th class="px-4 py-3">Name</th>
								<th class="px-4 py-3">ID</th>
								<th class="px-4 py-3">Created</th>
								<th class="px-4 py-3">Last used</th>
								<th class="px-4 py-3">Status</th>
								<th class="px-4 py-3"></th>
							</tr>
						</thead>
						<tbody class="divide-y divide-zinc-200">
							for _, key := range data.APIKeys {
								<tr>
									<td class="whitespace-nowrap px-4 py-3 font-medium">{ key.Name }</td>
									<td class="whitespace-nowrap px-4 py-3 font-mono text-xs text-zinc-600">{ key.ID }</td>
									<td class="whitespace-nowrap px-4 py-3 text-zinc-600">{ key.CreatedAt.Format("2006-01-02 15:04") }</td>
									<td class="whitespace-nowrap px-4 py-3 text-zinc-600">
										if key.LastUsedAt != nil {
											{ key.LastUsedAt.Format("2006-01-02 15:04") }
										} else {
											Never
										}
									</td>
									<td class="whitespace-nowrap px-4 py-3">
										if key.RevokedAt != nil {
											<span class="text-zinc-500">Revoked</span>
										} else {
											<span class="font-medium text-emerald-700">Active</span>
										}
									</td>
									<td class="whitespace-nowrap px-4 py-3 text-right">
										if key.RevokedAt == nil {
											<form
												hx-post={ "/_/api-keys/" + key.ID + "/revoke" }
												hx-target="#api-key-management"
												hx-swap="outerHTML"
												hx-confirm={ "Revoke " + key.Name + "?" }
											>
												<button class="border border-red-300 px-3 py-1.5 text-xs font-medium text-red-700 hover:bg-red-50" type="submit">Revoke</button>
											</form>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			} else {
				<p class="px-5 py-8 text-center text-sm text-zinc-500">No API tokens yet.</p>
			}
		</section>
	</div>
}
